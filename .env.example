# Copy this file to `.env` and fill in the values from your SAP CPI service key.
# The service key is created on the "Process Integration Runtime" (it-rt) service
# instance with plan "api" in your BTP subaccount.

# --- Single tenant --------------------------------------------------------------
# Use the plain vars below for one tenant. Skip this whole section if you're using
# the numbered multi-tenant vars further down instead — don't mix the two styles.

# Base URL of the CPI OData API (note the trailing /api/v1, no trailing slash after it):
CPI_BASE_URL=https://your-tenant.it-cpiXXX.cfapps.eu10.hana.ondemand.com/api/v1

# OAuth2 token endpoint (from the "tokenurl" field of the service key, ending in /oauth/token):
CPI_TOKEN_URL=https://your-subdomain.authentication.eu10.hana.ondemand.com/oauth/token

# OAuth2 client credentials (from the service key):
CPI_CLIENT_ID=your-client-id
CPI_CLIENT_SECRET=your-client-secret

# --- Credential Store (alternative to CPI_CLIENT_SECRET) --------------------------
# Keep the real client secret out of this file / manifest.yml / `cf env` entirely by
# storing it in a bound SAP Credential Store instance (see src/credStore.js) and
# pointing at it by name instead. When CPI_CREDSTORE_KEY is set, it's used INSTEAD OF
# CPI_CLIENT_SECRET above — don't set both for the same tenant.
# CPI_CREDSTORE_KEY=cpi-oauth-secret
# CPI_CREDSTORE_NAMESPACE=cpi-mcp   # optional, defaults to "cpi-mcp"
#
# Requires binding a `credstore` service instance in manifest.yml when deployed to CF.
# For local testing without a real CF binding, pull these straight out of a service key
# (`cf create-service-key <credstore-instance> local-dev` then `cf service-key
# <credstore-instance> local-dev`) — copy each field from its credentials block verbatim.
#
# Trial-plan / Basic-auth instances (the common case — confirmed against a real binding):
# CREDSTORE_URL=https://credstore.cfapps.<region>.hana.ondemand.com/api/v1/credentials
# CREDSTORE_USERNAME=<credentials.username from the service key>
# CREDSTORE_PASSWORD=<credentials.password from the service key>
# CREDSTORE_CLIENT_PRIVATE_KEY=<credentials.encryption.client_private_key — only needed if
#   credentials.parameters.encryption.payload is "enabled" in the service key>
#
# mTLS-plan instances (alternative, if your service key has certificate/key instead of
# username/password):
# CREDSTORE_URL=https://credstore.cfapps.<region>.hana.ondemand.com/api/v1/credentials
# CREDSTORE_CERT=-----BEGIN CERTIFICATE-----...
# CREDSTORE_KEY=-----BEGIN PRIVATE KEY-----...

# --- Multiple tenants -------------------------------------------------------------
# Add a numbered group of the same 4 vars (+ optional TENANT_NAME<N>) per tenant —
# CPI_BASE_URL1/2/3/... — and the server picks up as many as it finds, no code change.
# Once 2+ are configured, every tool gains a required `tenant` argument (the MCP
# client — e.g. Claude — sees the exact names below and will ask which one to use).
# TENANT_NAME<N> is what shows up in that argument; it defaults to "tenant<N>" if omitted.
#
# CPI_BASE_URL1=https://dev-tenant.it-cpiXXX.cfapps.eu10.hana.ondemand.com/api/v1
# CPI_TOKEN_URL1=https://dev-subdomain.authentication.eu10.hana.ondemand.com/oauth/token
# CPI_CLIENT_ID1=dev-client-id
# CPI_CLIENT_SECRET1=dev-client-secret
# TENANT_NAME1=Dev
#
# CPI_BASE_URL2=https://qa-tenant.it-cpiXXX.cfapps.eu10.hana.ondemand.com/api/v1
# CPI_TOKEN_URL2=https://qa-subdomain.authentication.eu10.hana.ondemand.com/oauth/token
# CPI_CLIENT_ID2=qa-client-id
# CPI_CLIENT_SECRET2=qa-client-secret
# TENANT_NAME2=QA
#
# CPI_CREDSTORE_KEY<N> works per-tenant too, and mixes freely with plain
# CPI_CLIENT_SECRET<N> tenants — migrate one tenant at a time instead of all-or-nothing.
# e.g. move only Prod (tenant 2) to Credential Store while Dev (tenant 1) stays on a
# plain env var:
# CPI_CREDSTORE_KEY2=cpi-oauth-secret-qa
#
# Optional per-tenant write override (falls back to the global ALLOW_WRITE below when
# unset) — e.g. allow writes on Dev but keep Prod read-only under one server:
# ALLOW_WRITE1=true

# Optional per-tenant on/off switch. Set to "disable" (or "disabled") to keep a
# tenant's credentials in this file but take it out of rotation entirely — it won't
# show up in list_cpi_tenants, won't count towards multi-tenant mode, and can't be
# selected via the `tenant` argument. Unset (or "enable") = enabled, the default.
# STATUS1=disable

# Transport: "stdio" for local Claude Desktop/Code, "http" for server deployment.
MCP_TRANSPORT=stdio

# Write safety: read tools always work. Set to "true" to enable create/update/delete/deploy
# tools. Destructive tools additionally require a confirm=true argument at call time.
# Acts as the default for every tenant; ALLOW_WRITE<N> (above) overrides it per tenant.
ALLOW_WRITE=false

# Only used when MCP_TRANSPORT=http. If set, callers must send Authorization: Bearer <token>.
# MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# Only used when MCP_TRANSPORT=http and running locally (CF injects its own PORT).
# PORT=3000
